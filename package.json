{
  "name": "react-sync-ui",
  "version": "2.0.0",
  "description": "Promise-based imperative React UI: await an alert, confirm or prompt like a function call.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Svehla/react-sync-ui.git"
  },
  "homepage": "https://github.com/Svehla/react-sync-ui#readme",
  "bugs": {
    "url": "https://github.com/Svehla/react-sync-ui/issues"
  },
  "keywords": [
    "react",
    "promise",
    "async",
    "await",
    "modal",
    "dialog",
    "confirm",
    "prompt",
    "alert",
    "queue",
    "hooks"
  ],
  "license": "MIT",
  "author": "Jakub Švehla",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && publint --strict && attw --pack . --profile esm-only",
    "prepare": "husky || true",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "size-limit": [
    {
      "name": "ESM bundle (brotli)",
      "path": "dist/index.js",
      "limit": "2 kB"
    }
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
